{
    "name": "@plearn/dependency",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm exec tsc",
        "dev": "pnpm exec tsc --watch",
        "lint": "pnpm exec eslint --cache --cache-location .cache/eslint . --fix",
        "prettier": "pnpm exec prettier --cache --cache-location .cache/prettier --ignore-path ../../.prettierignore . --write",
        "clean": "rm -rf dist .turbo .cache",
        "fullclean": "pnpm run clean && rm -rf node_modules",
        "check-types": "pnpm exec tsc --noEmit"
    },
    "prettier": "@plearn/prettier",
    "dependencies": {
        "@plearn/core": "workspace:*",
        "@plearn/db": "workspace:*",
        "@plearn/utils": "workspace:*"
    },
    "devDependencies": {
        "@plearn/eslint": "workspace:*",
        "@plearn/prettier": "workspace:*",
        "@plearn/typescript": "workspace:*",
        "@types/node": "catalog:"
    },
    "exports": {
        "./postgres/learning/converter": {
            "types": "./src/postgres/learning/converter.ts",
            "default": "./dist/postgres/learning/converter.js"
        },
        "./postgres/learning/facade": {
            "types": "./src/postgres/learning/facade.ts",
            "default": "./dist/postgres/learning/facade.js"
        },
        "./postgres/srs/converter": {
            "types": "./src/postgres/srs/converter.ts",
            "default": "./dist/postgres/srs/converter.js"
        },
        "./postgres/srs/facade": {
            "types": "./src/postgres/srs/facade.ts",
            "default": "./dist/postgres/srs/facade.js"
        }
    }
}
