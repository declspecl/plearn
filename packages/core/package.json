{
    "name": "@plearn/core",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm exec tsc",
        "dev": "pnpm exec tsc --watch",
        "lint": "pnpm exec eslint --cache --cache-location .cache/eslint . --fix",
        "prettier": "pnpm exec prettier --cache --cache-location .cache/prettier --ignore-path ../../.prettierignore . --write",
        "clean": "rm -rf dist .turbo .cache",
        "fullclean": "pnpm run clean && rm -rf node_modules",
        "check-types": "pnpm exec tsc --noEmit"
    },
    "prettier": "@plearn/prettier",
    "dependencies": {
        "@plearn/utils": "workspace:*",
        "kuromoji": "catalog:",
        "wanakana": "catalog:"
    },
    "devDependencies": {
        "@plearn/eslint": "workspace:*",
        "@plearn/prettier": "workspace:*",
        "@plearn/typescript": "workspace:*",
        "@types/kuromoji": "catalog:",
        "@types/node": "catalog:"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./task": {
            "types": "./src/task/index.ts",
            "default": "./dist/task/index.js"
        },
        "./task/model": {
            "types": "./src/task/model/index.ts",
            "default": "./dist/task/model/index.js"
        },
        "./task/repository": {
            "types": "./src/task/repository.ts",
            "default": "./dist/task/repository.js"
        },
        "./task/service": {
            "types": "./src/task/service.ts",
            "default": "./dist/task/service.js"
        },
        "./learning": {
            "types": "./src/learning/index.ts",
            "default": "./dist/learning/index.js"
        },
        "./learning/model": {
            "types": "./src/learning/model/index.ts",
            "default": "./dist/learning/model/index.js"
        },
        "./learning/repository": {
            "types": "./src/learning/repository.ts",
            "default": "./dist/learning/repository.js"
        },
        "./learning/service": {
            "types": "./src/learning/service.ts",
            "default": "./dist/learning/service.js"
        },
        "./learning/language-config": {
            "types": "./src/learning/language-config.ts",
            "default": "./dist/learning/language-config.js"
        },
        "./learning/text-processor": {
            "types": "./src/learning/text-processor.ts",
            "default": "./dist/learning/text-processor.js"
        },
        "./shared": {
            "types": "./src/shared/index.ts",
            "default": "./dist/shared/index.js"
        },
        "./shared/clock": {
            "types": "./src/shared/clock.ts",
            "default": "./dist/shared/clock.js"
        },
        "./shared/logger": {
            "types": "./src/shared/logger.ts",
            "default": "./dist/shared/logger.js"
        },
        "./shared/model/id": {
            "types": "./src/shared/model/id.ts",
            "default": "./dist/shared/model/id.js"
        },
        "./vietnamese/tone-parser": {
            "types": "./src/vietnamese/tone-parser.ts",
            "default": "./dist/vietnamese/tone-parser.js"
        },
        "./srs": {
            "types": "./src/srs/index.ts",
            "default": "./dist/srs/index.js"
        },
        "./srs/model": {
            "types": "./src/srs/model/index.ts",
            "default": "./dist/srs/model/index.js"
        },
        "./srs/algorithm": {
            "types": "./src/srs/algorithm.ts",
            "default": "./dist/srs/algorithm.js"
        },
        "./srs/repository": {
            "types": "./src/srs/repository.ts",
            "default": "./dist/srs/repository.js"
        },
        "./srs/service": {
            "types": "./src/srs/service.ts",
            "default": "./dist/srs/service.js"
        },
        "./srs/ai": {
            "types": "./src/srs/ai.ts",
            "default": "./dist/srs/ai.js"
        }
    }
}
