{
    "name": "@plearn/scripts",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm exec tsc --noEmit",
        "owner:bootstrap:dev": "pnpm exec dotenv -e ../../apps/website/.env.development -e ../../apps/website/.env.development.local -- pnpm exec tsx src/bootstrap-owner.ts",
        "sync-root-workspace-scripts": "pnpm exec tsx src/sync-root-workspace-scripts.ts",
        "lint": "pnpm exec eslint --cache --cache-location .cache/eslint . --fix",
        "prettier": "pnpm exec prettier --cache --cache-location .cache/prettier --ignore-path ../../.prettierignore . --write",
        "clean": "rm -rf .turbo .cache",
        "fullclean": "pnpm run clean && rm -rf node_modules",
        "check-types": "pnpm exec tsc --noEmit"
    },
    "prettier": "@plearn/prettier",
    "dependencies": {
        "drizzle-orm": "catalog:"
    },
    "devDependencies": {
        "@plearn/eslint": "workspace:*",
        "@plearn/prettier": "workspace:*",
        "@plearn/typescript": "workspace:*",
        "@types/node": "catalog:",
        "dotenv-cli": "catalog:",
        "tsx": "catalog:"
    }
}
