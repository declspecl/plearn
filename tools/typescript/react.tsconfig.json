{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./base.tsconfig.json",
    "compilerOptions": {
        "lib": ["es2023", "DOM", "DOM.Iterable"],
        "noEmit": false,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "inlineSources": false,
        "jsx": "react-jsx",
        "preserveWatchOutput": true
    }
}
