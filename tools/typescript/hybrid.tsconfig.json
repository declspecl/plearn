{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./base.tsconfig.json",
    "compilerOptions": {
        "lib": ["es2023", "DOM", "DOM.Iterable"],
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": true,
        "emitDeclarationOnly": false,
        "noEmit": false,
        "jsx": "react-jsx",
        "types": ["node"]
    }
}
