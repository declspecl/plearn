{
    "name": "plearn",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "auth:generate": "pnpm dlx auth@latest generate --config ./packages/auth/auth.ts",
        "auth:info": "pnpm dlx auth@latest info --config ./packages/auth/auth.ts",
        "auth:secret": "pnpm dlx auth@latest secret",
        "lint": "turbo run lint && pnpm exec eslint --config tests/eslint.config.mjs --cache --cache-location tests/.cache/eslint tests --fix",
        "prettier": "turbo run prettier && pnpm exec prettier --cache --cache-location tests/.cache/prettier --ignore-path .prettierignore tests --write",
        "check-types": "turbo run check-types && pnpm exec tsc -p tests/tsconfig.json --noEmit",
        "clean": "rm -rf .turbo .cache tests/.cache coverage && turbo run clean",
        "fullclean": "rm -rf .turbo .cache tests/.cache node_modules && turbo run fullclean",
        "test": "vitest run --coverage",
        "test:clearbox": "vitest run --config vitest.clearbox.config.ts",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:watch": "vitest",
        "prepare": "husky",
        "cdk:bootstrap": "pnpm --filter @plearn/cdk run bootstrap",
        "cdk:deploy": "pnpm --filter @plearn/cdk run deploy",
        "cdk:diff": "pnpm --filter @plearn/cdk run diff",
        "cdk:synth": "pnpm --filter @plearn/cdk run synth",
        "website:start": "pnpm --filter @plearn/website run start",
        "db:clean:dev": "pnpm --filter @plearn/db run db:clean:dev",
        "db:generate:dev": "pnpm --filter @plearn/db run db:generate:dev",
        "db:generate:prod": "pnpm --filter @plearn/db run db:generate:prod",
        "db:migrate:dev": "pnpm --filter @plearn/db run db:migrate:dev",
        "db:migrate:prod": "pnpm --filter @plearn/db run db:migrate:prod",
        "db:push:dev": "pnpm --filter @plearn/db run db:push:dev",
        "db:start:dev": "pnpm --filter @plearn/db run db:start:dev",
        "db:studio:dev": "pnpm --filter @plearn/db run db:studio:dev",
        "db:studio:prod": "pnpm --filter @plearn/db run db:studio:prod",
        "db:test:down": "pnpm --filter @plearn/db run db:test:down",
        "db:test:migrate": "pnpm --filter @plearn/db run db:test:migrate",
        "db:test:push": "pnpm --filter @plearn/db run db:test:push",
        "db:test:up": "pnpm --filter @plearn/db run db:test:up",
        "scripts:owner:bootstrap:dev": "pnpm --filter @plearn/scripts run owner:bootstrap:dev",
        "scripts:sync-root-workspace-scripts": "pnpm --filter @plearn/scripts run sync-root-workspace-scripts",
        "db:dev:compiler": "pnpm --filter @plearn/db run dev:compiler",
        "db:dev:db-tools": "pnpm --filter @plearn/db run dev:db-tools",
        "scripts:owner:bootstrap:prod": "pnpm --filter @plearn/scripts run owner:bootstrap:prod",
        "scripts:languages:seed:dev": "pnpm --filter @plearn/scripts run languages:seed:dev",
        "scripts:languages:seed:prod": "pnpm --filter @plearn/scripts run languages:seed:prod"
    },
    "prettier": "@plearn/prettier",
    "devDependencies": {
        "@plearn/prettier": "workspace:*",
        "dotenv-cli": "catalog:",
        "eslint": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "husky": "catalog:",
        "lint-staged": "catalog:",
        "prettier": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "packageManager": "pnpm@10.32.0",
    "engines": {
        "node": ">=24"
    }
}
