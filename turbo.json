{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "globalEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SERVER_URL",
        "BETTER_AUTH_API_PATH",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "PLEARN_OWNER_EMAIL",
        "PLEARN_OWNER_NAME",
        "PLEARN_OWNER_PASSWORD",
        "NEXT_PUBLIC_API_URL",
        "INTERNAL_PAGES_ENABLED",
        "NODE_ENV",
        "VERCEL_URL",
        "PORT",
        "BASE_URL",
        "VITE_BASE_URL",
        "NEXT_PUBLIC_BETTER_AUTH_URL",
        "DEEPSEEK_API_KEY",
        "OPENAI_API_KEY",
        "LEARNING_ANALYSIS_PROVIDER",
        "LEARNING_ANALYSIS_MODEL",
        "LEARNING_ANALYSIS_MAX_RETRIES",
        "LEARNING_ANALYSIS_TIMEOUT_MS",
        "LEARNING_ANALYSIS_THINKING_MODE",
        "LEARNING_ANALYSIS_STREAM_PROBE",
        "LEARNING_EMBEDDING_PROVIDER",
        "LEARNING_EMBEDDING_MODEL",
        "TRANSIT_ASSISTANT_MODEL",
        "TRANSIT_ASSISTANT_REASONING_EFFORT",
        "TRANSIT_ASSISTANT_SEARCH_CONTEXT_SIZE",
        "TRANSIT_ASSISTANT_TIMEOUT_MS",
        "TRANSIT_ASSISTANT_MAX_RETRIES",
        "TRANSIT_ASSISTANT_MAX_RUNS_PER_HOUR"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "prettier": {
            "dependsOn": ["^prettier"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "clean": {
            "dependsOn": ["^clean"],
            "cache": false
        },
        "fullclean": {
            "dependsOn": ["^fullclean"],
            "cache": false
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        }
    }
}
